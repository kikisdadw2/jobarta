%% Flow registrasi seeker — revisi 2026-08-31
%% Versi 2026-08-21 masih tersimpan di Diagram Jobarta.zip (jangan ditimpa).
%% Perubahan: tidak ada lagi halaman daftar/register. Pendaftaran = login Google
%% pertama kali. Cabang "Sudah punya akun?" diganti pemeriksaan profiles.role,
%% dan consent PDP pindah ke SESUDAH akun Auth terbentuk (konsekuensi OAuth).
%% Langkah "Lengkapi Profil" (DESIGN 3B) ditambahkan sebagai langkah OPSIONAL.

flowchart TD
    A([Mulai]) --> B[Buka JOBARTA]
    B --> C[Tekan &quot;Lanjutkan dengan Google&quot;]
    C --> D[/Pilih akun Google<br/>+ izinkan akses profil dasar/]
    D --> D0{Berhasil?}
    D0 -->|Batal atau gagal| D0a[Kembali ke halaman masuk<br/>+ pesan alasan]
    D0a --> Z([Selesai])
    D0 -->|Ya| E[(Akun Auth terbentuk<br/>auth.users + baris profiles kosong)]

    E --> F{profiles.role sudah terisi?}
    F -->|Sudah| M{Izinkan akses lokasi?}

    F -->|Belum — pengguna baru| G[Halaman /onboarding:<br/>pilih peran Pencari Kerja]
    G --> H[/Setujui Kebijakan Privasi<br/>UU PDP No. 27 Tahun 2022/]
    H --> I{Setuju?}
    I -->|Tidak| I1[Akun tidak diaktifkan<br/>+ tawaran hapus data]
    I1 --> Z
    I -->|Ya| J[(UPDATE profiles<br/>role = seeker<br/>consent_pdp = true, consent_at = now)]

    J --> K[Halaman /lengkapi-profil<br/>DESIGN 3B — OPSIONAL<br/>foto, nama, CV]
    K --> L{Lengkapi sekarang?}
    L -->|Nanti saja| M
    L -->|Ya| L1[(Simpan avatar_url, full_name<br/>CV masuk ke cv_files)]
    L1 --> M

    M -->|Ya| N[Peta berpusat di<br/>lokasi pengguna]
    M -->|Tidak| O[Pilih kecamatan<br/>secara manual]
    O --> N
    N --> P([Lanjut ke<br/>Alur Cari dan Lamar])
