%% ERD AUTH JOBARTA — dibuat 2026-08-31
%% Zoom-in dari 01-erd.mmd. Yang digambar di sini HANYA seputar login, peran,
%% dan persetujuan. Entitas domain (JOBS, APPLICATIONS, dst) sengaja tidak ikut.
%%
%% Garis batas yang harus dipahami dulu:
%%   Kotak berawalan AUTH_ = milik SUPABASE AUTH (skema `auth`). JOBARTA tidak
%%   membuat, mengubah, atau memigrasi tabel-tabel ini — cuma membacanya.
%%   Sisanya = skema `public`, milik JOBARTA sepenuhnya.
%%
%% REVISI 2026-08-31 (kedua): Google BUKAN lagi satu-satunya jalan masuk.
%% Ditambah jalur username unik + password. Tiga akibat yang digambar di bawah:
%%   1. AUTH_USERS.encrypted_password kini DIPAKAI (sebelumnya selalu kosong).
%%   2. PROFILES.username jadi kolom UNIK — identitas masuk untuk jalur password.
%%   3. AUTH_USERS.email jadi OPSIONAL pada jalur password.
%%
%% 🔴 KETERBATASAN SUPABASE: auth.users mewajibkan email/telepon — login username
%%    murni tidak didukung asli. Jalan keluarnya: sistem membuat email SINTETIS
%%    internal dari username (mis. rizky@users.jobarta.app) yang tidak pernah
%%    ditampilkan ke pengguna. Kolom is_synthetic_email menandainya.
%%
%% 🔴 AKIBAT YANG HARUS DISADARI: akun tanpa email pemulihan TIDAK BISA dipulihkan
%%    kalau lupa password. Layar daftar wajib menyatakan itu terang-terangan.

erDiagram
    AUTH_USERS ||--|| PROFILES : "identitas login"
    AUTH_USERS ||--o{ AUTH_IDENTITIES : "ditautkan ke"
    AUTH_USERS ||--o{ AUTH_SESSIONS : "punya sesi"
    AUTH_SESSIONS ||--o{ AUTH_REFRESH_TOKENS : "menerbitkan"

    PROFILES ||--o{ CONSENT_RECORDS : "memberi persetujuan"
    PROFILES ||--o{ ROLE_CHANGES : "riwayat peran"
    PROFILES ||--o{ DELETION_REQUESTS : "mengajukan penghapusan"
    POLICY_VERSIONS ||--o{ CONSENT_RECORDS : "disetujui pada versi"

    AUTH_USERS {
        uuid id PK "dipakai sebagai profiles.id"
        citext email UK "dari Google, ATAU sintetis dari username"
        text encrypted_password "DIPAKAI di jalur password, kosong di jalur Google"
        jsonb raw_user_meta_data "name, picture dari Google | username dari jalur password"
        timestamptz email_confirmed_at "kosong bila email sintetis"
        timestamptz last_sign_in_at
        timestamptz created_at
        timestamptz deleted_at "soft delete"
        text CATATAN "EKSTERNAL - skema auth, dikelola Supabase. Password di-hash Supabase, JOBARTA tidak pernah menyimpannya sendiri."
    }

    AUTH_IDENTITIES {
        uuid id PK
        uuid user_id FK "auth_users.id"
        text provider "google - satu-satunya"
        text provider_id "sub dari Google, stabil selamanya"
        jsonb identity_data "profil mentah dari Google"
        timestamptz last_sign_in_at
        text CATATAN "EKSTERNAL. HANYA ada di jalur Google - akun jalur password tidak punya baris di sini."
    }

    AUTH_SESSIONS {
        uuid id PK
        uuid user_id FK "auth_users.id"
        timestamptz not_after "kedaluwarsa sesi"
        text user_agent "untuk daftar perangkat aktif"
        inet ip
        timestamptz created_at
        text CATATAN "EKSTERNAL. Sumber fitur logout dari semua perangkat."
    }

    AUTH_REFRESH_TOKENS {
        bigint id PK
        uuid session_id FK "auth_sessions.id"
        text token UK
        bool revoked
        timestamptz created_at
        text CATATAN "EKSTERNAL. JOBARTA tidak pernah menyentuh ini langsung."
    }

    PROFILES {
        uuid id PK,FK "= auth_users.id, dibuat trigger on-auth-user-created"
        citext username UK "3-20 karakter, huruf angka titik garis-bawah, tidak bisa diubah bebas"
        enum auth_method "google | password"
        citext recovery_email "OPSIONAL di jalur password - tanpa ini akun tidak bisa dipulihkan"
        bool recovery_email_verified
        bool is_synthetic_email "true bila auth_users.email dikarang dari username"
        citext email "salinan dari auth_users"
        enum role "NULL saat baru | seeker | employer | recruiter | admin"
        enum account_status "pending_consent | active | deactivated | pending_deletion"
        text full_name "prefill dari Google, BISA DIUBAH"
        text avatar_url
        bool consent_pdp "ringkasan cepat - riwayat sahnya di CONSENT_RECORDS"
        timestamptz consent_at
        timestamptz created_at
    }

    POLICY_VERSIONS {
        uuid id PK
        enum doc_type "privacy | tos"
        text version "mis. 2026-08-31.1"
        text content_hash "sidik jari isi dokumen saat itu"
        text url
        timestamptz effective_from
        bool is_current
    }

    CONSENT_RECORDS {
        uuid id PK
        uuid user_id FK "profiles.id"
        uuid policy_version_id FK
        bool granted "true = setuju, false = menolak/mencabut"
        enum consent_point "form_daftar | onboarding"
        timestamptz acted_at
        inet ip "bukti pemberian consent"
        text user_agent
        text CATATAN "APPEND-ONLY. Baris tidak pernah diubah atau dihapus - mencabut = baris baru granted=false."
    }

    ROLE_CHANGES {
        uuid id PK
        uuid user_id FK "profiles.id"
        enum role_from "NULL saat penetapan pertama"
        enum role_to
        uuid changed_by FK "profiles.id - diri sendiri atau admin"
        text reason
        timestamptz changed_at
        text CATATAN "Jejak audit eskalasi hak akses. Wajib karena setelah OAuth user punya token sah."
    }

    DELETION_REQUESTS {
        uuid id PK
        uuid user_id FK "profiles.id"
        enum trigger "menolak_pdp | permintaan_pengguna | mencabut_consent"
        enum status "requested | processing | completed | cancelled"
        timestamptz requested_at
        timestamptz completed_at "tenggat wajib - lihat catatan"
        text CATATAN "Dipicu antara lain saat user MENOLAK consent PDP di /onboarding, sebab akun Auth sudah terlanjur terbentuk."
    }
