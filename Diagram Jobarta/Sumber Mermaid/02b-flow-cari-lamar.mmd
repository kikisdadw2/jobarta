%% Flow cari & lamar — revisi 2026-08-31
%% Versi 2026-08-21 masih tersimpan di Diagram Jobarta.zip (jangan ditimpa).
%% Perubahan: ditambahkan sheet "Lampirkan CV" JUST-IN-TIME (DESIGN 3B artboard 5)
%% yang muncul saat menekan Lamar pertama kali, beserta jalan keluar untuk seeker
%% yang belum punya CV. INSERT applications sekarang menyimpan cv_file_id.

flowchart TD
    A([Peta terbuka]) --> B[Sistem baca batas viewport peta<br/>minLng, minLat, maxLng, maxLat]
    B --> C[(Query PostGIS:<br/>ST_MakeEnvelope + ST_DWithin<br/>status = published)]
    C --> D{Ada lowongan?}
    D -->|Tidak| E[Tampilkan pesan kosong<br/>+ saran perluas radius]
    E --> F
    D -->|Ya| G[Tampilkan pin di peta<br/>+ daftar kartu lowongan<br/>urut jarak terdekat]
    G --> F{Aksi pengguna}
    F -->|Geser atau zoom peta| B
    F -->|Ubah filter| H[Atur radius, rentang gaji,<br/>tipe pekerjaan]
    H --> B
    F -->|Klik pin atau kartu| I[Buka detail lowongan]
    I --> J{Tertarik melamar?}
    J -->|Tidak| F
    J -->|Ya| K{Sudah login?}
    K -->|Belum| L[Arahkan ke &quot;Lanjutkan dengan Google&quot;]
    L --> I
    K -->|Sudah| M{Sudah pernah melamar<br/>lowongan ini?}
    M -->|Sudah| N[Tampilkan pesan:<br/>lamaran sudah terkirim]
    N --> F

    M -->|Belum| S{Punya CV aktif?<br/>cv_files.is_active}
    S -->|Sudah| O
    S -->|Belum| T[/Sheet &quot;Lampirkan CV untuk melamar<br/>di NAMA PERUSAHAAN&quot;<br/>DESIGN 3B artboard 5/]
    T --> U{Punya berkas CV?}
    U -->|Tutup sheet| I
    U -->|Ya| V[Unggah berkas<br/>PDF DOC DOCX maks 5 MB]
    V --> V1{Berkas sah?}
    V1 -->|Tidak| V2[Pesan sebab + cara perbaiki<br/>tepat di bawah dropzone]
    V2 --> V
    V1 -->|Ya| W[(INSERT cv_files<br/>owner_id, file_url, is_active = true)]
    W --> O
    U -->|Belum punya| X[Isi data singkat<br/>halaman profil terstruktur]
    X --> W

    O[Isi catatan pengantar<br/>opsional] --> P[(INSERT applications<br/>status = submitted<br/>cv_file_id = CV yang dipakai<br/>UNIQUE job_id + seeker_id)]
    P --> Q[Tampil di halaman<br/>Lamaran Saya]
    Q --> R([Selesai])
