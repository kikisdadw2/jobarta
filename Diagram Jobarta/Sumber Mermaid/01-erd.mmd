%% ERD JOBARTA — revisi 2026-08-31
%% Versi 2026-08-21 masih tersimpan di Diagram Jobarta.zip (jangan ditimpa).
%% Perubahan:
%%   1. AUTH_USERS digambar sebagai entitas eksternal (milik Supabase Auth, di luar
%%      skema aplikasi) — sebelumnya cuma komentar "= auth.users.id" di PROFILES.
%%   2. PROFILES dapat avatar_url (foto profil, dari DESIGN 3B).
%%   3. Entitas baru CV_FILES — satu seeker boleh punya banyak berkas CV.
%%   4. APPLICATIONS dapat cv_file_id: lamaran menyimpan CV VERSI YANG DIKIRIM,
%%      bukan yang terbaru. Ganti CV tidak mengubah lamaran lama.
%%   5. PROFILES.email tidak lagi UK sendiri — sumber kebenarannya AUTH_USERS.

erDiagram
    AUTH_USERS ||--|| PROFILES : "identitas login"

    PROFILES ||--o{ COMPANY_MEMBERS : "tergabung di"
    COMPANIES ||--o{ COMPANY_MEMBERS : "punya anggota"
    COMPANIES ||--o{ JOBS : "memasang"
    PROFILES ||--o{ JOBS : "membuat"
    JOBS ||--o{ APPLICATIONS : "menerima"
    PROFILES ||--o{ APPLICATIONS : "mengirim"
    PROFILES ||--o{ CV_FILES : "mengunggah"
    CV_FILES ||--o{ APPLICATIONS : "dilampirkan di"
    REGIONS ||--o{ JOBS : "menaungi"
    REGIONS ||--o{ PROFILES : "domisili"
    REGIONS ||--o{ REGIONS : "membawahi"

    AUTH_USERS {
        uuid id PK "dikelola Supabase Auth"
        citext email UK "dari akun Google"
        text provider "google (satu-satunya)"
        timestamptz last_sign_in_at
        timestamptz created_at
        text CATATAN "ENTITAS EKSTERNAL — di luar skema aplikasi, tidak dibuat JOBARTA"
    }

    PROFILES {
        uuid id PK,FK "= auth_users.id"
        citext email "salinan dari auth_users, untuk join cepat"
        enum role "seeker | employer | recruiter | admin"
        text full_name "prefill dari Google, bisa diubah"
        text avatar_url "foto profil, Supabase Storage"
        text phone
        text headline "ringkasan seeker"
        text_array skills
        int experience_years
        int expected_salary_min
        int expected_salary_max
        geography location "Point 4326, domisili"
        uuid region_id FK
        bool consent_pdp "persetujuan UU PDP, diminta di /onboarding"
        timestamptz consent_at
        timestamptz created_at
    }

    CV_FILES {
        uuid id PK
        uuid owner_id FK "profiles.id"
        text file_url "Supabase Storage, akses via signed URL"
        text file_name "nama asli saat diunggah"
        int size_bytes "maks 5 MB"
        enum mime_type "pdf | doc | docx"
        bool is_active "CV yang dipakai secara default"
        timestamptz uploaded_at
    }

    COMPANIES {
        uuid id PK
        text name
        text slug UK
        text description
        text logo_url
        text website
        enum verif_status "unverified | pending | verified | rejected"
        text nib "nomor induk berusaha"
        text npwp
        uuid verified_by FK "admin"
        timestamptz verified_at
        timestamptz created_at
    }

    COMPANY_MEMBERS {
        uuid company_id PK,FK
        uuid user_id PK,FK
        enum member_role "owner | admin | recruiter"
        timestamptz joined_at
    }

    JOBS {
        uuid id PK
        uuid company_id FK
        uuid posted_by FK "profiles.id"
        text title
        text description
        enum employment_type "fulltime | parttime | kontrak | magang"
        int salary_min
        int salary_max
        bool salary_visible
        text address_text
        geography location "Point 4326, WAJIB"
        uuid region_id FK
        enum status "draft | published | closed | expired"
        timestamptz published_at
        timestamptz expires_at
        timestamptz created_at
    }

    APPLICATIONS {
        uuid id PK
        uuid job_id FK
        uuid seeker_id FK "profiles.id"
        uuid cv_file_id FK "CV versi yang dikirim, tidak ikut berubah"
        enum status "submitted | viewed | interview | accepted | rejected"
        text cover_note
        timestamptz created_at
        timestamptz updated_at
    }

    REGIONS {
        uuid id PK
        text name "DKI Jakarta / kecamatan / kelurahan"
        enum level "provinsi | kota | kecamatan | kelurahan"
        uuid parent_id FK
        geometry geom "MultiPolygon, batas wilayah"
    }
